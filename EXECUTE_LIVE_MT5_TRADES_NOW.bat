@echo off
setlocal EnableDelayedExpansion
title ETHERFLOW v4.2 BINO HUMAN-MIND AI - MULTI-TIMEFRAME STACK BUILD
color 0A
echo ===========================================================================
echo   ETHERFLOW v4.2 BINO HUMAN-MIND AI BRAIN - 100%% NATIVE MT5 CONTROLLER
echo   MULTI-TF STACK BUILD: Takes M15 + H1 + H4 setups on the SAME asset
echo   Plus trend-continuation scale-ins on strong setups (up to 4 per asset)
echo ===========================================================================
echo.
set "BOT_DIR=C:\Bino_EtherFlow_ForexVPS"
if not exist "%BOT_DIR%" mkdir "%BOT_DIR%"
if not exist "%BOT_DIR%\MQL5_Experts" mkdir "%BOT_DIR%\MQL5_Experts"
set "B64_FILE=%TEMP%\bino_ea_payload.b64"
set "EA_SRC=%BOT_DIR%\MQL5_Experts\Bino_EtherFlow_Institutional_AI_EA.mq5"
echo [STEP 1/5] Extracting Unified Human-Mind AI Brain EA...
call :WRITE_EA_B64 > "%B64_FILE%"
certutil -f -decode "%B64_FILE%" "%EA_SRC%" >nul 2>&1
copy /Y "%EA_SRC%" "%BOT_DIR%\Bino_EtherFlow_Institutional_AI_EA.mq5" >nul 2>&1
copy /Y "%EA_SRC%" "%BOT_DIR%\AetherFlow_Institutional_AI_EA.mq5" >nul 2>&1
echo   - EA extracted successfully.

echo [STEP 2/5] Installing EA into All MetaTrader 5 Data Folders...
set "MT5_DATA_ROOT=%APPDATA%\MetaQuotes\Terminal"
if exist "%MT5_DATA_ROOT%" (
    for /d %%D in ("%MT5_DATA_ROOT%\*") do (
        if exist "%%~fD\MQL5\Experts" (
            copy /Y "%EA_SRC%" "%%~fD\MQL5\Experts\Bino_EtherFlow_Institutional_AI_EA.mq5" >nul 2>&1
            copy /Y "%EA_SRC%" "%%~fD\MQL5\Experts\AetherFlow_Institutional_AI_EA.mq5" >nul 2>&1
            if exist "%%~fD\MQL5\Files\bino_global_news_status.json" del /F /Q "%%~fD\MQL5\Files\bino_global_news_status.json" >nul 2>&1
            echo   - Installed into: %%~nxD
        )
    )
)

echo [STEP 3/5] Compiling EA with MetaEditor64...
set "ME_EXE="
for %%P in (
    "C:\Program Files\MetaTrader 5 EXNESS\metaeditor64.exe"
    "C:\Program Files\MetaTrader 5\metaeditor64.exe"
    "C:\Program Files\Exness MetaTrader 5\metaeditor64.exe"
) do (
    if exist %%P set "ME_EXE=%%~P"
)
if defined ME_EXE (
    for /d %%D in ("%MT5_DATA_ROOT%\*") do (
        if exist "%%~fD\MQL5\Experts\Bino_EtherFlow_Institutional_AI_EA.mq5" (
            "%ME_EXE%" /compile:"%%~fD\MQL5\Experts\Bino_EtherFlow_Institutional_AI_EA.mq5" /log
            "%ME_EXE%" /compile:"%%~fD\MQL5\Experts\AetherFlow_Institutional_AI_EA.mq5" /log
            if exist "%%~fD\MQL5\Experts\Bino_EtherFlow_Institutional_AI_EA.ex5" (
                copy /Y "%%~fD\MQL5\Experts\Bino_EtherFlow_Institutional_AI_EA.ex5" "%%~fD\MQL5\Experts\AetherFlow_Institutional_AI_EA.ex5" >nul 2>&1
                echo   - Compiled EX5 READY in %%~nxD
            )
        )
    )
)

echo [STEP 4/5] Writing MT5 autostart config...
set "INI_FILE=%BOT_DIR%\mt5_autostart.ini"
echo [Common]> "%INI_FILE%"
echo KeepPrivate=1>> "%INI_FILE%"
echo NewsEnable=1>> "%INI_FILE%"
echo [Charts]>> "%INI_FILE%"
echo Symbol=XAUUSDm>> "%INI_FILE%"
echo Period=H1>> "%INI_FILE%"
echo [Experts]>> "%INI_FILE%"
echo AllowDllImport=1>> "%INI_FILE%"
echo Enabled=1>> "%INI_FILE%"
echo AllowLiveTrading=1>> "%INI_FILE%"
echo Api=1>> "%INI_FILE%"
echo Expert=Bino_EtherFlow_Institutional_AI_EA>> "%INI_FILE%"
echo Symbol=XAUUSDm>> "%INI_FILE%"
echo Period=H1>> "%INI_FILE%"

echo [STEP 5/5] Launching MetaTrader 5...
set "MT5_EXE="
for %%T in (
    "C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe"
    "C:\Program Files\MetaTrader 5\terminal64.exe"
    "C:\Program Files\Exness MetaTrader 5\terminal64.exe"
) do (
    if exist %%T set "MT5_EXE=%%~T"
)
if defined MT5_EXE (
    taskkill /IM terminal64.exe /F >nul 2>&1
    timeout /t 2 /nobreak >nul
    start "" "%MT5_EXE%" /config:"%INI_FILE%"
    echo   - MetaTrader 5 launched with the Human-Mind AI Brain.
)
echo.
echo ===========================================================================
echo   MULTI-TIMEFRAME STACKING ACTIVE
echo   - The LIVE SETUP MATRIX on the chart shows which setup formed
echo     on which asset on which timeframe (M15 / H1 / H4)
echo   - Simultaneous M15 + H1 + H4 setups on one asset are ALL taken
echo   - Trend-continuation scale-ins allowed on strong setups
echo ===========================================================================
timeout /t 6
exit /b 0

